---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArchFrame from '../components/ArchFrame.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWorks, illustration, workHref } from '../lib/collections';
import { aboutShort, tagline } from '../data/profile';
import portrait from '../assets/christine/home.png';

const featured = (await getWorks()).filter((w) => w.data.featured).sort((a, b) => a.data.featured! - b.data.featured!);
if (featured.length > 3) {
  throw new Error(`At most 3 works can be featured; found ${featured.length}: ${featured.map((w) => w.id).join(', ')}`);
}
---
<Base title="Home" description="The portfolio of Christine Guarda, writer and communications and media creative, AB Communication at UST–Legazpi.">
  <section class="hero">
    <div class="hero-text">
      <p class="dek hero-welcome">Welcome to my portfolio!</p>
      <h1 class="name-plate hero-name">Christine<br />Guarda</h1>
      <p class="entry-title hero-tagline">{tagline}</p>
    </div>
    <ArchFrame>
      <Image src={portrait} alt="Christine Guarda" widths={[280, 370, 560, 740]} sizes="(max-width: 900px) 280px, 370px" loading="eager" fetchpriority="high" />
    </ArchFrame>
  </section>

  <section class="intro">
    <div class="intro-head"><h2 class="intro-title">A little about me</h2></div>
    <div class="intro-body">
      <p>{aboutShort}</p>
      <Button href="/about" class="intro-more">Read more</Button>
      <ArrowLink href="/about" class="intro-link">Read more</ArrowLink>
    </div>
  </section>

  <section class="featured">
    <SectionHead variant="split" dek="Stories, publications, and productions that shaped my work in communication.">Featured works</SectionHead>
    <div class="cg-work-grid featured-grid">
      {featured.map((w) => (
        <WorkCard title={w.data.title} medium={w.data.medium} role={w.data.roles[0]} href={workHref(w)} mediaLink>
          <Fragment slot="image"><Image src={illustration(w).src} alt="" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 360px" /></Fragment>
        </WorkCard>
      ))}
    </div>
    <div class="featured-more"><Button variant="outline" href="/works/academic">Explore my work</Button></div>
  </section>
</Base>

<style>
  /* Hero: the welcome line, name and tagline centred beside the arch. */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); align-items: center; gap: var(--space-8); padding-bottom: var(--space-12); }
  .hero-text { container-type: inline-size; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); text-align: center; }
  .hero-welcome { margin: 0; font-size: clamp(20px, 4.4cqi, 32px); line-height: 1.25; }
  /* Canva sets the name lighter than the name-plate's 900; it shrinks with its column so "CHRISTINE" fits. */
  .hero-name { margin: 0; font-size: clamp(44px, 17cqi, 124px); font-weight: 600; line-height: 0.86; text-transform: uppercase; color: var(--press-blue); }
  .hero-tagline { margin: 0; font-size: clamp(18px, 4.4cqi, 32px); line-height: 1.25; }
  /* A taller arch than the default 5:6, with the portrait filling its height so the head rises above it. */
  .hero > :global(.cg-arch) { max-width: 420px; aspect-ratio: 3 / 4; }
  .hero :global(.cg-arch-field) { top: 8%; }
  .hero :global(.cg-arch-img img) { width: auto; height: 100%; }

  /* "A little about me": a heavy rule above, a vertical rule beside the head, the text in the right half. */
  .intro { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); padding-top: var(--space-6); border-top: var(--stroke-heavy) solid var(--rule); }
  .intro-head { container-type: inline-size; display: flex; align-items: center; padding: var(--space-12) 0 var(--space-12) var(--space-8); border-left: var(--stroke-heavy) solid var(--rule); }
  .intro-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 18cqi, 100px); line-height: 0.92; text-transform: uppercase; color: var(--press-blue); }
  .intro-body { display: flex; flex-direction: column; justify-content: center; gap: var(--space-8); }
  /* Justified, as in Canva, with hyphenation so lines don't open gaps; ragged right on phones (below). */
  .intro-body p { margin: 0; max-width: var(--measure); font-size: 20px; line-height: 33px; text-align: justify; hyphens: auto; }
  @media (max-width: 640px) {
    .intro-body p { text-align: left; }
  }
  /* "Read more": a pill as wide as the text; where the section stacks (below), an underlined arrow link on its own
     line under the text instead, at the right. */
  .intro-body > :global(.intro-link) { display: none; align-self: flex-end; }
  .intro-body > :global(.intro-link span) { text-decoration: underline; text-decoration-thickness: var(--stroke); text-underline-offset: 6px; }

  /* Featured works: the dek reads left to right beside the head; wider gaps between the cards. */
  .featured { display: flex; flex-direction: column; gap: var(--space-8); }
  .featured > :global(.cg-sh-split) { align-items: flex-start; gap: var(--space-12); }
  .featured > :global(.cg-sh-split .cg-sh-title) { font-size: 54px; line-height: 58px; }
  .featured > :global(.cg-sh-split .cg-sh-dek) { max-width: 34em; padding-top: var(--space-2); text-align: left; }
  .featured-grid { gap: var(--space-12) var(--space-16); }
  .featured-grid :global(.cg-work-media img) { object-position: 50% 20%; }
  .featured-grid :global(.cg-work-title) { margin-top: var(--space-3); font-size: 36px; line-height: 40px; }
  .featured-grid :global(.cg-work-meta) { font-size: 20px; line-height: 28px; }
  .featured-grid :global(.cg-work-link) { margin-top: var(--space-4); }
  .featured-more { display: flex; justify-content: center; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero > :global(.cg-arch) { justify-self: center; max-width: 320px; }
    .featured-grid { gap: var(--space-8); }
    .featured > :global(.cg-sh-split) { flex-direction: column; gap: var(--space-2); }
    .featured > :global(.cg-sh-split .cg-sh-dek) { padding-top: 0; }
  }
  @media (max-width: 800px) {
    .intro { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); }
    .intro-head { padding: var(--space-6) 0 var(--space-6) var(--space-6); }
    .intro-body > :global(.intro-link) { display: inline-flex; }
    .intro-body > :global(.intro-more) { display: none; }
  }
  @media (max-width: 720px) {
    .featured > :global(.cg-sh-split .cg-sh-title) { font-size: 34px; line-height: 38px; }
    .featured-grid :global(.cg-work-title) { font-size: 28px; line-height: 32px; }
  }
</style>
