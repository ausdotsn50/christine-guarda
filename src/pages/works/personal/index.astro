---
// The Personal Works section front: the flag and sub-navigation, then a band per sub-section previewing it (the
// first piece of each of the first four series, the first four essays), each with "See all". Plates and essays
// open in a Lightbox.
import Base from '../../../layouts/Base.astro';
import Band from '../../../components/site/Band.astro';
import EssayClip from '../../../components/site/EssayClip.astro';
import Plate from '../../../components/site/Plate.astro';
import SectionFlag from '../../../components/site/SectionFlag.astro';
import { personalPages, workGroups } from '../../../data/categories';
import { countLabel, getEssays, getGalleries, platesOf } from '../../../lib/collections';

const group = workGroups.personal;
const series = await getGalleries('digital-art');
const plates = series.flatMap(platesOf);
const preview = series.map((s) => platesOf(s)[0]).filter(Boolean).slice(0, 4);
const essays = await getEssays();
---
<Base title={group.title} description={group.dek}>
  <SectionFlag group={group} pages={personalPages} current="/works/personal" />

  <Band title="Digital Art" meta={`${countLabel(series.length, 'series', 'series')} · ${countLabel(plates.length, 'piece')}`} href="/works/personal/digital-art">
    {plates.length > 0
      ? <div class="shelf">{preview.map((p) => <Plate {...p} showSeries />)}</div>
      : <p class="band-empty">Pieces coming soon.</p>}
  </Band>

  <Band title="Essays" meta={countLabel(essays.length, 'essay')} href="/works/personal/essays">
    {essays.length > 0
      ? <div class="shelf is-text">{essays.slice(0, 4).map((e) => <EssayClip essay={e} />)}</div>
      : <p class="band-empty">Essays coming soon.</p>}
  </Band>
</Base>
