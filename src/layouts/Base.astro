---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/canva.css';
import '../styles/site.css';
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import logo from '../assets/logos/cg-blue.png';
import defaultShareImage from '../assets/christine/og.jpg';
import Masthead from '../components/Masthead.astro';
import ContactFooter from '../components/ContactFooter.astro';
import SiteMenu from '../components/site/SiteMenu.astro';
import { siteName, dateline, nav, navSection, contacts, social, footerNav, menuLinks } from '../data/site';

interface Props {
  /** The page name; the document title becomes "{title} | Christine Guarda". Leave out on the front page. */
  title?: string;
  description: string;
  image?: ImageMetadata;
  /** Alt text for the link-preview image. */
  imageAlt?: string;
  noindex?: boolean;
  /** Leave out the Masthead and ContactFooter (the styleguide renders them as specimens). */
  bare?: boolean;
}
// Slot "next": Return / Next ArrowLinks, set between rules just above the footer.

const { title, description, image = defaultShareImage, imageAlt = 'Christine Guarda', noindex = false, bare = false } = Astro.props;

const docTitle = title ? `${title} | ${siteName}` : `${siteName} | Portfolio`;
const current = navSection(Astro.url.pathname);
const links = nav.map(({ section, label, href }) => ({ label, href, active: section === current }));

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
// Link previews (Facebook, Messenger, LinkedIn, X) need absolute URLs, hence `site` in astro.config.
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = site ? new URL(share.src, site).href : undefined;
// Icons in public/ (favicon.ico, apple-touch-icon.png) are cg-brown.png on paper; theme-color is oxblood, so
// mobile browsers tint their toolbar to match the menu bar.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#612c2d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <SiteMenu items={menuLinks(Astro.url.pathname)} />}
    {!bare && (
      <Masthead class="site-mast" links={links} dateline={dateline} homeHref="/" topBar={false}>
        <Fragment slot="monogram"><Image src={logo} alt="" width={112} loading="eager" /></Fragment>
      </Masthead>
    )}
    <div class="site">
      <main id="main" class="site-main">
        <slot />
      </main>
      {Astro.slots.has('next') && <div class="site-next"><slot name="next" /></div>}
      {!bare && <ContactFooter contacts={contacts} social={social} nav={footerNav} />}
    </div>
  </body>
</html>
