---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/canva.css';
import '../styles/site.css';
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import logo from '../assets/logos/cg-blue.png';
import Masthead from '../components/Masthead.astro';
import ContactFooter from '../components/ContactFooter.astro';
import SiteMenu from '../components/site/SiteMenu.astro';
import { siteName, dateline, nav, navSection, contacts, social, footerNav, menuLinks } from '../data/site';

interface Props {
  /** The page name; the document title becomes "{title} · Christine Guarda". Leave out on the front page. */
  title?: string;
  description: string;
  /** Open Graph image. Emitted only once `site` is set in astro.config, since it must be absolute. */
  image?: ImageMetadata;
  noindex?: boolean;
  /** Leave out the Masthead and ContactFooter (the styleguide renders them as specimens). */
  bare?: boolean;
}
// Slot "next": Return / Next ArrowLinks, set between rules just above the footer.

const { title, description, image, noindex = false, bare = false } = Astro.props;

const docTitle = title ? `${title} · ${siteName}` : `${siteName} · Portfolio`;
const current = navSection(Astro.url.pathname);
const links = nav.map(({ section, label, href }) => ({ label, href, active: section === current }));

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site && image ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <SiteMenu items={menuLinks(Astro.url.pathname)} />}
    {!bare && (
      <Masthead class="site-mast" links={links} dateline={dateline} homeHref="/" topBar={false}>
        <Fragment slot="monogram"><Image src={logo} alt="" width={112} loading="eager" /></Fragment>
      </Masthead>
    )}
    <div class="site">
      <main id="main" class="site-main">
        <slot />
      </main>
      {Astro.slots.has('next') && <div class="site-next"><slot name="next" /></div>}
      {!bare && <ContactFooter contacts={contacts} social={social} nav={footerNav} />}
    </div>
  </body>
</html>
