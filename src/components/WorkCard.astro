---
import ArrowLink from './ArrowLink.astro';

interface Props {
  title: string;
  /** The format, e.g. "Radio". Joined to role as "Radio | Head Writer". */
  medium?: string;
  role?: string;
  href?: string;
  /** A kicker above the title, e.g. "Quill Awards · Excellence". */
  award?: string;
  linkLabel?: string;
  class?: string;
}
// Slot "image": a 3:2 <img> or <Image>, ideally a blue line illustration. A halftone placeholder shows without one.

const { title, medium, role, href: hrefProp, award, linkLabel, class: className } = Astro.props;
const href = hrefProp || '#';
const meta = [medium, role].filter(Boolean).join(' | ');
// Rendered up front so a conditionally empty image slot still falls back to the placeholder.
const image = Astro.slots.has('image') ? (await Astro.slots.render('image')).trim() : '';
---
<article class:list={['cg-work', className]}>
  <a href={href} class="cg-work-media" tabindex="-1" aria-hidden="true">{image ? <Fragment set:html={image} /> : <span class="cg-work-placeholder"></span>}</a>
  {award && <p class="cg-kicker cg-work-award">{award}</p>}
  <h3 class="cg-work-title"><a href={href}>{title}</a></h3>
  {meta && <p class="cg-work-meta">{meta}</p>}
  <ArrowLink href={href} class="cg-work-link">{linkLabel || 'View project'}<span class="cg-sr">{`: ${title}`}</span></ArrowLink>
</article>
