---
// Internal to ArrowLink: Ionicons' arrow-forward in currentColor (flipped for "back" by .cg-arrow-back).
// Not part of the design system's API.
import { icon } from '../lib/icons';

interface Props {
  back?: boolean;
}

const { back = false } = Astro.props;
---
<Fragment set:html={icon('arrowForwardOutline', { size: 28, className: back ? 'cg-arrow cg-arrow-back' : 'cg-arrow' })} />
