---
// A gallery piece as a plate: a tile with its caption ("Pl. 3 — Asparagus"); pressing the tile floats the piece,
// whole and as large as the screen allows, in a Lightbox. Artworks sit whole on a ruled paper mount in a 3:4 tile
// (most are drawn at 3:4, as Instagram's grid now is); photos fill a square tile.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
  /** Its number within the series or event. */
  number: number;
  /** The series or event. */
  series: string;
  year?: number;
  /** The piece's own name, e.g. "Asparagus"; the series stands in without one. */
  title?: string;
  /** A line about the piece, shown in the preview. */
  caption?: string;
  /** The caption's mark before the number: "Pl." for art (default), "Photo" for documentation. */
  mark?: string;
  /** "art": whole on a 3:4 paper mount (default); "photo": cropped to fill a square. */
  variant?: 'art' | 'photo';
  /** Add the series to the tile's caption, where plates from several series sit together. */
  showSeries?: boolean;
}

const { id, src, alt, number, series, year, title, caption, mark = 'Pl.', variant = 'art', showSeries = false } = Astro.props;
const name = title ?? series;
const source = [title && series, year].filter(Boolean).join(', ');
---
<figure class:list={['plate', `is-${variant}`]}>
  <button class="plate-open" type="button" popovertarget={id}>
    <Image src={src} alt={alt} widths={[300, 600]} sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 300px" />
    <span class="cg-sr">(view larger)</span>
  </button>
  <figcaption><span class="plate-no">{mark} {number}</span> — {name}{showSeries && title && <span class="plate-series"> · {series}</span>}</figcaption>
</figure>
<Lightbox id={id} label={`${mark} ${number}, ${name}`} class="lightbox-plate">
  <figure class="plate-large">
    <Image src={src} alt={alt} widths={[800, 1200, 1600, 2000]} sizes="min(100vw, 100vh)" loading="lazy" />
    <figcaption><span class="plate-no">{mark} {number}</span> — {name}{source && `. ${source}`}.{caption && <Fragment> <em>{caption}</em></Fragment>}</figcaption>
  </figure>
</Lightbox>

<style>
  .plate { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .plate-open { display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius-none); overflow: hidden; cursor: zoom-in; }
  .plate-open :global(img) { display: block; width: 100%; height: 100%; transition: transform .3s ease; }
  .plate-open:hover :global(img) { transform: scale(1.03); }
  .is-art .plate-open { aspect-ratio: 3 / 4; background: var(--paper); outline: var(--stroke-hair) solid var(--rule); outline-offset: -1px; }
  .is-art .plate-open :global(img) { object-fit: contain; }
  .is-photo .plate-open { aspect-ratio: 1; background: var(--press-blue); }
  .is-photo .plate-open :global(img) { object-fit: cover; }
  .plate figcaption { font-family: var(--font-text); font-style: italic; font-size: 14px; line-height: 20px; color: var(--oxblood); }
  .plate-no { font-style: normal; font-weight: 700; letter-spacing: .06em; color: var(--press-blue-deep); }
  /* In the preview: the whole piece, never cropped, on paper (some art has transparent parts), with room left for
     the caption and the ×. */
  .plate-large { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .plate-large :global(img) { display: block; width: auto; height: auto; max-width: calc(100vw - 2 * var(--space-16)); max-height: calc(100dvh - 2 * var(--space-16) - var(--space-12)); background: var(--paper); }
  .plate-large figcaption { max-width: var(--measure); font-family: var(--font-text); font-size: 16px; line-height: 24px; text-align: center; color: var(--on-oxblood); }
  .plate-large .plate-no { color: var(--on-oxblood); }
  @media (max-width: 640px) {
    .plate-large :global(img) { max-width: calc(100vw - 2 * var(--page-margin-sm)); }
  }
  @media (prefers-reduced-motion: reduce) { .plate-open :global(img) { transition: none; } }
</style>
