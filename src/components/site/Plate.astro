---
// A gallery piece as a plate: a ruled tile with its caption ("Pl. 3 — Asparagus"); pressing the tile floats the
// piece, whole and as large as the screen allows, in a Lightbox. Two kinds: art sits whole on a paper mount in a 3:4
// tile (most pieces are drawn at 3:4, as Instagram's grid now is); a photo fills a square tile. With its shelf's
// neighbours (see inSequence), the preview steps to the previous / next plate and shows "3 of 7" (see Lightbox). Lay
// plates out with PlateShelf.
// A photo plate can be a short clip instead ("Video 1"): it plays muted and looping in its tile while on screen,
// over its poster frame and marked "Video", and plays larger in the preview, with controls. Where motion is
// reduced, the tile keeps the poster and the preview waits for its play button.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';
import { icon } from '../../lib/icons';
import type { PlateKind } from '../../lib/collections';

interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
  /** Its number within the series or event. */
  number: number;
  /** The series or event. */
  series: string;
  year?: number;
  /** The piece's own name, e.g. "Asparagus"; the series stands in without one. */
  title?: string;
  /** A line about the piece, shown in the preview. */
  caption?: string;
  /** A clip's address (see platesOf): the plate plays it, with `src` as its poster frame. */
  video?: string;
  /** "art" (default): a Digital Art piece, "Pl. 3"; "photo": a Documentation photo, "Photo 3". */
  kind?: PlateKind;
  /** Add the series to the tile's caption, where plates from several series sit together. */
  showSeries?: boolean;
  /** The previous and next plates' ids on the shelf, and this one's place on it. */
  prev?: string;
  next?: string;
  position?: number;
  total?: number;
}

const { id, src, alt, number, series, year, title, caption, video, kind = 'art', showSeries = false, prev, next, position, total = 1 } = Astro.props;
const { mark, thing } = video ? { mark: 'Video', thing: 'photo' } : kind === 'photo' ? { mark: 'Photo', thing: 'photo' } : { mark: 'Pl.', thing: 'piece' };
const play = icon('play', { size: 14 });
const name = title ?? series;
const source = [title && series, year].filter(Boolean).join(', ');
---
<figure class:list={['plate', `is-${kind}`]}>
  <button class="plate-open" type="button" popovertarget={id}>
    <Image src={src} alt={alt} widths={[300, 600]} sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 300px" />
    {video && <video class="plate-clip" src={video} muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true" tabindex="-1" data-autoplay />}
    {video
      ? <span class="plate-badge"><span class="plate-badge-icon" set:html={play} />Video<span class="cg-sr"> (open to play)</span></span>
      : <span class="cg-sr">(view larger)</span>}
  </button>
  <figcaption><span class="plate-no">{mark} {number}</span> — {name}{showSeries && title && <span class="plate-series"> - {series}</span>}</figcaption>
</figure>
<Lightbox id={id} label={`${mark} ${number}, ${name}`} prev={prev} next={next} total={total} thing={thing} class="lightbox-plate">
  <figure class="plate-large">
    {video
      ? <video class="plate-large-clip" src={video} muted loop playsinline controls preload="none" aria-label={alt} width={src.width} height={src.height} style={`aspect-ratio: ${src.width} / ${src.height}`} data-fit />
      : <Image src={src} alt={alt} widths={[800, 1200, 1600, 2000]} sizes="min(100vw, 100vh)" loading="lazy" draggable="false" data-fit />}
    <figcaption data-fit-caption>
      {total > 1 && <span class="lightbox-count">{position} of {total}</span>}
      <span><span class="plate-no">{mark} {number}</span> — {name}{source && `. ${source}`}.{caption && <Fragment> <em>{caption}</em></Fragment>}</span>
    </figcaption>
  </figure>
</Lightbox>

<script>
  // Clips in tiles play while at least a quarter shows, unless motion is reduced; the poster shows until one plays.
  // A clip in a preview plays when the preview opens (unless motion is reduced: then its play button) and stops
  // when it closes.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const onScreen = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const clip = e.target as HTMLVideoElement;
      if (e.isIntersecting && !still.matches) clip.play().catch(() => {});
      else clip.pause();
    }
  }, { threshold: 0.25 });
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((clip) => {
    clip.addEventListener('playing', () => clip.classList.add('is-playing'));
    onScreen.observe(clip);
  });
  document.addEventListener('toggle', (e) => {
    const clip = (e.target as Element).querySelector?.<HTMLVideoElement>('.plate-large-clip');
    if (!clip) return;
    if ((e as ToggleEvent).newState === 'open') { if (!still.matches) clip.play().catch(() => {}); }
    else clip.pause();
  }, true);
</script>

<style>
  .plate { margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  /* The tile: ruled in a hairline, like a picture box on a printed page. A border, not an outline, so the picture and
     its hover zoom stay inside it. */
  .plate-open { position: relative; box-sizing: border-box; display: block; width: 100%; padding: 0; border: var(--stroke-hair) solid var(--rule); border-radius: var(--radius-none); overflow: hidden; cursor: zoom-in; background: var(--paper); }
  .plate-open :global(img) { display: block; width: 100%; height: 100%; transition: transform .3s ease; }
  .plate-open:hover :global(img) { transform: scale(1.03); }
  .is-art .plate-open { aspect-ratio: 3 / 4; }
  .is-art .plate-open :global(img) { object-fit: contain; }
  .is-photo .plate-open { aspect-ratio: 1; }
  .is-photo .plate-open :global(img) { object-fit: cover; }
  /* A clip: over its poster, shown once it plays (no black frame while it loads), marked in its corner. */
  .plate-clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .3s ease, transform .3s ease; pointer-events: none; }
  .plate-clip.is-playing { opacity: 1; }
  .plate-open:hover .plate-clip { transform: scale(1.03); }
  .plate-badge { position: absolute; left: var(--space-2); bottom: var(--space-2); z-index: 1; display: inline-flex; align-items: center; gap: var(--space-1); padding: 2px var(--space-2); background: var(--oxblood); color: var(--on-oxblood); font-family: var(--font-text); font-weight: 700; font-size: 12px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; }
  .plate-badge-icon { display: inline-flex; }
  .plate figcaption { font-family: var(--font-text); font-style: italic; font-size: 14px; line-height: 20px; color: var(--oxblood); }
  .plate-no { font-style: normal; font-weight: 700; letter-spacing: .06em; color: var(--press-blue-deep); }
  /* In the preview: the whole piece, never cropped, on paper (some art has transparent parts), as large as the
     screen allows once the × row above, the caption below and (on wider screens) the steps either side have their
     room. A sideways swipe steps (see Lightbox); pinching zooms. */
  .plate-large { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); touch-action: pan-y pinch-zoom; }
  .plate-large { --plate-max-w: calc(100vw - 2 * var(--space-8) - 2 * (48px + var(--space-4))); }
  .plate-large :global(img) { display: block; width: auto; height: auto; max-width: var(--plate-max-w); max-height: var(--room-h); background: var(--paper); }
  /* A clip takes the height it's allowed at its own shape (it has no size of its own until it loads). */
  .plate-large-clip { display: block; width: auto; height: var(--room-h); max-width: var(--plate-max-w); object-fit: contain; background: var(--paper); }
  .plate-large figcaption { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); max-width: var(--measure); font-family: var(--font-text); font-size: 16px; line-height: 24px; text-align: center; color: var(--on-oxblood); }
  .plate-large .plate-no { color: var(--on-oxblood); }
  /* Wider screens: the piece and its caption on the preview's two content rows (see Lightbox), so the steps line up
     with the piece. */
  @media (min-width: 641px) {
    .plate-large { display: grid; grid-row: 1 / -1; grid-template-rows: subgrid; row-gap: var(--space-4); justify-items: center; }
  }
  /* Phones: the piece takes the width, and the height left after the two bars and the caption. */
  @media (max-width: 640px) {
    .plate-large { --plate-max-w: calc(100vw - 2 * var(--page-margin-sm)); }
  }
  @media (prefers-reduced-motion: reduce) { .plate-open :global(img), .plate-clip { transition: none; } }
</style>
