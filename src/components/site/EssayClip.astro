---
// An essay as a clipping: a cream card with its kicker, its title and its opening lines fading out.
// The whole card opens the essay in a Lightbox, set on a sheet like an op-ed page, which scrolls on its own. With
// its group's neighbours (see inSequence), the preview steps to the previous / next essay and shows "3 of 6".
import Byline from '../Byline.astro';
import type { BylineItem } from '../types';
import { essayGroups } from '../../data/categories';
import { essayPreviewId } from '../../lib/collections';
import EssayBody from './EssayBody.astro';
import Lightbox from './Lightbox.astro';
import { icon } from '../../lib/icons';
import type { Essay } from '../../lib/collections';

interface Props {
  essay: Essay;
  /** The card title's heading level: 3 under a band's head, 2 straight under the page title. */
  level?: 2 | 3;
  /** The previous and next essays' preview ids in the group, and this one's place in it. */
  prev?: string;
  next?: string;
  position?: number;
  total?: number;
}

const { essay, level = 3, prev, next, position, total = 1 } = Astro.props;
const { title, group, kicker, year, context } = essay.data;
const label = [kicker ?? essayGroups.find((g) => g.key === group)?.kicker, year].filter(Boolean).join(' - ');
const credits: BylineItem[] = [{ label: 'By', value: 'Christine Guarda' }];
if (year) credits.push({ label: 'Year', value: String(year) });
if (context) credits.push({ label: 'Written for', value: context });
const id = essayPreviewId(essay);
const Tag = `h${level}` as const;
const arrow = icon('arrowForwardOutline', { size: 16 });
// The opening paragraph, its tags dropped, for the card.
const opening = ((essay.rendered?.html ?? '').match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '').replace(/<[^>]+>/g, '');
---
<article class="clip">
  <p class="clip-kick">{label}</p>
  <Tag class="clip-title"><button class="clip-open" type="button" popovertarget={id}>{title}</button></Tag>
  <p class="clip-text" set:html={opening} />
  <p class="clip-cont" aria-hidden="true">Continued <span set:html={arrow} /></p>
</article>
<Lightbox id={id} label={title} prev={prev} next={next} total={total} thing="essay" class="lightbox-essay">
  <article class="sheet">
    <p class="sheet-kick">{label}</p>
    <h2 class="sheet-title">{title}</h2>
    <Byline items={credits} />
    <EssayBody essay={essay} />
  </article>
  {total > 1 && <p class="lightbox-count">{position} of {total}</p>}
</Lightbox>

<style>
  .clip { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4); background: var(--paper-deep); border: var(--stroke-hair) solid var(--rule); border-radius: var(--radius-none); }
  .clip-kick, .clip-cont { margin: 0; font-family: var(--font-text); font-weight: 700; font-size: 12px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; color: var(--press-blue-deep); }
  .clip-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 28px; text-transform: uppercase; color: var(--press-blue); }
  /* The title's button covers the whole card, so the card is one target; its focus ring shows on the card. */
  .clip-open { padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: inherit; text-transform: inherit; cursor: pointer; }
  .clip-open::after { content: ''; position: absolute; inset: 0; }
  .clip-open:focus-visible { box-shadow: none; }
  .clip:has(.clip-open:focus-visible) { box-shadow: var(--focus-ring); }
  .clip:has(.clip-open:hover) .clip-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .clip-text { margin: 0; max-height: calc(4 * 24px); overflow: hidden; font-family: var(--font-text); font-size: 15px; line-height: 24px; color: var(--oxblood); -webkit-mask-image: linear-gradient(#000 45%, transparent); mask-image: linear-gradient(#000 45%, transparent); }
  .clip-cont { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: auto; padding-top: var(--space-2); }
  .clip-cont span { display: inline-flex; }

  /* The sheet: one column of the essay on cream paper inside a rule, scrolling within the preview, as tall as the
     screen allows once the × row above and the count below have their room, and as wide as the steps either side
     leave. Vertical drags scroll it; sideways swipes step (see Lightbox). */
  .sheet { box-sizing: border-box; width: min(760px, calc(100vw - 2 * var(--space-8) - 2 * (48px + var(--space-4)))); max-height: calc(100dvh - 2 * var(--space-8) - 2 * (48px + var(--space-3))); overflow: auto; touch-action: pan-y pinch-zoom; overscroll-behavior: contain; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-12); background: var(--paper-deep); border: var(--stroke) solid var(--rule); border-radius: var(--radius-none); }
  .sheet-kick { margin: 0; font-family: var(--font-text); font-weight: 700; font-size: 13px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; color: var(--press-blue-deep); }
  .sheet-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 52px; line-height: 56px; text-transform: uppercase; color: var(--press-blue); }
  .sheet :global(.cg-article) { max-width: none; }
  .sheet :global(.cg-article.is-two-col) { column-count: 1; }
  /* Phones: the full width, and the height left after the × bar, the count and the steps bar (see Lightbox). */
  @media (max-width: 640px) {
    .sheet { width: calc(100vw - 2 * var(--page-margin-sm)); max-height: calc(100dvh - 2 * var(--space-4) - 3 * (48px + var(--space-3))); padding: var(--space-8) var(--space-4); }
    .sheet-title { font-size: 34px; line-height: 38px; }
  }
</style>
