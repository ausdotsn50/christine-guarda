---
import type { FooterItem } from './types';

interface Props {
  /** Default "Let’s get in touch!" */
  title?: string;
  contacts?: FooterItem[];
  social?: FooterItem[];
  nav?: FooterItem[];
  legal?: string;
  class?: string;
}

const { title, contacts = [], social = [], nav = [], legal, class: className } = Astro.props;
// Optional glyphs (FooterItem.icon). Without them the markup is exactly bundle.js's.
const contactIcons = contacts.some((c) => c.icon);
// Site addition: a "credit" slot sits at the right of the legal line (both in .cg-foot-bottom); without it the markup
// is bundle.js's.
const hasCredit = Astro.slots.has('credit');
// Site addition: links to other sites (the social profiles) open in a new tab.
const external = (href: string) => (/^https?:\/\//.test(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<footer class:list={['cg-foot', className]}>
  <div class="cg-foot-grid">
    <p class="cg-foot-title">{title || 'Let’s get in touch!'}</p>
    <div class="cg-foot-col">
      <p class="cg-kicker">Contact</p>
      {contactIcons ? (
        <ul class="cg-foot-list cg-foot-contact">
          {contacts.map((c) => (
            <li class:list={[c.icon && 'has-icon']}><span class="cg-foot-icon" aria-hidden="true">{c.icon && <Fragment set:html={c.icon} />}</span><span>{c.href ? <a href={c.href}>{c.label}</a> : c.label}{c.note && <span class="cg-foot-note">{` (${c.note})`}</span>}</span></li>
          ))}
        </ul>
      ) : (
        <ul class="cg-foot-list">
          {contacts.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}{c.note && <span class="cg-foot-note">{` (${c.note})`}</span>}</li>
          ))}
        </ul>
      )}
    </div>
    <div class="cg-foot-col">
      <p class="cg-kicker">Find me</p>
      <ul class="cg-foot-social">
        {social.map((s) => (
          <li>{s.href ? (
            s.icon
              ? <a href={s.href} {...external(s.href)}><span class="cg-foot-icon" aria-hidden="true"><Fragment set:html={s.icon} /></span><span class="cg-sr">{s.label}{external(s.href).target && ' (opens in a new tab)'}</span></a>
              : <a href={s.href} {...external(s.href)}>{s.label}{external(s.href).target && <span class="cg-sr"> (opens in a new tab)</span>}</a>
          ) : s.label}</li>
        ))}
      </ul>
    </div>
    <div class="cg-foot-col">
      <p class="cg-kicker">Navigate</p>
      <ul class="cg-foot-list">
        {nav.map((n) => <li>{n.href ? <a href={n.href}>{n.label}</a> : n.label}</li>)}
      </ul>
    </div>
  </div>
  {hasCredit
    ? <div class="cg-foot-bottom"><p class="cg-foot-legal">{legal || '© ausdotsn50 | All rights reserved.'}</p><slot name="credit" /></div>
    : <p class="cg-foot-legal">{legal || '© ausdotsn50 | All rights reserved.'}</p>}
</footer>
